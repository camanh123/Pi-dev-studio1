# Project-local OpenSail/generated-app configuration.
# NOT official Pi Platform environment variables.

# Maps to Pi.init({ sandbox: ... }) only — does NOT change Developer Portal App Network.
VITE_PI_SDK_SANDBOX=true

# Vite /api proxy target (dev server only).
# - OpenSail Kubernetes: sibling inject → http://dev-backend:8001 (do not hardcode).
# - Bare local (frontend+backend on one machine): defaults to http://localhost:8001
# - Docker multi-container: set VITE_BACKEND_URL=http://backend:8001 if needed
# VITE_BACKEND_URL=http://localhost:8001
