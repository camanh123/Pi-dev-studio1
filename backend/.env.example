# Project-local OpenSail/generated-app configuration.
# These are NOT official Pi Platform environment-variable names.

# Allowlisted Platform API base (Phase 1 catalog).
PI_API_BASE=https://api.minepi.com/v2

# Server-only secret for Key-authenticated payment operations.
# Leave empty here. Set the real value in your deployment secret store.
# NEVER put this in frontend env (no VITE_*), HTML, README, or git.
PI_SERVER_API_KEY=
